{
  "name": "odm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 . && node scripts/check-no-em-dash.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "assets": "bash tools/blender/build-all.sh",
    "browser": "node tools/runner/run.mjs",
    "smoke": "node tools/runner/run.mjs smoke no-webgpu",
    "perf": "node tools/runner/run.mjs perf",
    "replays": "node tools/runner/run.mjs replays"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
